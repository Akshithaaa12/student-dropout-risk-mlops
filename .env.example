# Copy this file to .env and adjust as needed.
# The Part 1 pipeline uses SQLite (no server credentials required), but
# per the brief's "use environment variables for database credentials
# and API keys" rule, the DB location itself is environment-driven, and
# placeholders are provided for the ERP/LMS connectors this pipeline
# would use in a real institutional deployment (or if you switch to
# PostgreSQL later in Part 2).

DB_PATH=db/student_performance.db

# Only needed if you switch the loader to PostgreSQL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=student_performance
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# Only needed if you wire up a real college ERP / LMS API instead of the
# simulated CSV exports used in Part 1:
# ERP_API_BASE_URL=
# ERP_API_KEY=
# LMS_API_BASE_URL=
# LMS_API_KEY=

# ---- Part 2 (MLOps) ---------------------------------------------------------
# Default is a local SQLite MLflow store in ./mlstore (no setup needed).
# To log to DagsHub instead (the "GitHub/DagsHub link" for the review), create a repo
# on DagsHub, then set these (get the token from DagsHub > Settings > Tokens):
# MLFLOW_TRACKING_URI=https://dagshub.com/<your-username>/<repo-name>.mlflow
# MLFLOW_TRACKING_USERNAME=<your-username>
# MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Serve the model straight from the MLflow registry alias instead of models/champion.joblib:
# USE_MLFLOW_REGISTRY=1
